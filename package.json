{
  "name": "factory-web",
  "version": "1.0.0",
  "private": true,
  "description": "工厂原型 - Factorio clone in browser",
  "scripts": {
    "data": "node tools/generate-game-data.js",
    "serve": "npx http-server -p 8094 -c-1",
    "serve:dist": "cd dist & npx http-server -p 8094 -c-1",
    "dev": "node build.js --dev --port 8094",
    "watch": "node build.js --watch",
    "build": "node build.js",
    "build:minify": "node build.js --minify"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fengari": "^0.1.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
